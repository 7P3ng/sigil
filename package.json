{
  "name": "sigil",
  "version": "0.1.0",
  "description": "Generate custom Claude Code slash commands tailored to your repo's stack.",
  "type": "module",
  "bin": {
    "sigil": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/generate-catalog.mjs",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "claude-code",
    "claude",
    "slash-commands",
    "cli",
    "developer-tools"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "kleur": "^4.1.5",
    "mri": "^1.2.0",
    "tinyglobby": "^0.2.10"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
